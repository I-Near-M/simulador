# ==============================================================================
# CONFIGURACIÓN DEL SIMULADOR DE NODOS - SENTINEL-H2O (VPS PRODUCCIÓN)
# ==============================================================================

# URL base de la API de Sentinel-H2O
SENTINEL_API_URL=https://sentinel.mguillermo.com/api/v1

# Endpoint de Ingesta IoT
TELEMETRY_ENDPOINT=/telemetry/

# Intervalo de transmisión (600s = 10 minutos)
SEND_INTERVAL_SECONDS=600

# Clave Maestra de API del proyecto
MASTER_API_KEY=sentinel_h2o_master_secret_2026

# Probabilidad de eventos extremos o anomalías por ciclo (0.08 = 8%)
ANOMALY_PROBABILITY=0.08

# Nivel de logs (INFO o DEBUG)
LOG_LEVEL=INFO

# API Keys reales de las 6 estaciones registradas en la Base de Datos del VPS
API_KEY_NODO_01=sec_key_nodo_01_cabecera_67c935eec78775536188d962
API_KEY_NODO_02=sec_key_ravira_secure_02
API_KEY_NODO_03=sec_key_acos_secure_03
API_KEY_NODO_04=sec_key_huando_secure_04
API_KEY_NODO_05=sec_key_huayopampa_secure_05
API_KEY_NODO_06=sec_key_chancay_secure_06
