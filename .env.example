# ==============================================================================
# CONFIGURACIÓN DEL SIMULADOR DE NODOS - SENTINEL-H2O
# ==============================================================================

# URL base de la API de Sentinel-H2O en tu VPS o Localhost
SENTINEL_API_URL=https://sentinel.mguillermo.com/api/v1

# Endpoint de Ingesta IoT
TELEMETRY_ENDPOINT=/telemetry/

# Intervalo de envío de telemetría por ciclo (en segundos) -> 600s = 10 min
SEND_INTERVAL_SECONDS=600

# Clave Maestra de API (para provisión automática de nodos si faltan)
MASTER_API_KEY=sentinel_master_key_chancay_2026_secure
AUTO_PROVISION_NODES=true

# Probabilidad de eventos anómalos o extremos por ciclo (0.08 = 8%)
ANOMALY_PROBABILITY=0.08

# Nivel de logs (INFO o DEBUG)
LOG_LEVEL=INFO

# API Keys secretas de cada nodo (pueden ser las generadas en la Web App)
API_KEY_NODO_01=hash_key_cabecera_secure_01
API_KEY_NODO_02=hash_key_pacaraos_secure_02
API_KEY_NODO_03=hash_key_conduccion_secure_02
API_KEY_NODO_04=hash_key_huando_secure_04
API_KEY_NODO_05=hash_key_parcela_secure_03
API_KEY_NODO_06=hash_key_puerto_secure_06
